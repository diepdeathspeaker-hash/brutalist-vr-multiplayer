{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "xr-spatial-tracking=(self), fullscreen=(self)" }] },
    { "source": "/(models|audio|textures)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
